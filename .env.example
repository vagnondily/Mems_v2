# ─────────────────────────────────────────────────────────────────────
#  MEMS — variables d'environnement
#  Copiez ce fichier en « .env » et renseignez-le. Ne le versionnez jamais.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Connexion PostgreSQL (16+). En conteneur, le service « postgres » du
# docker-compose fourni sert cette adresse ; hors conteneur, pointez vers votre
# propre instance. Obligatoire en production — sans elle le serveur refuse de
# démarrer plutôt que de deviner une base locale.
DATABASE_URL=postgres://mems:changez-moi@127.0.0.1:5432/mems
DB_POOL_MAX=10             # connexions simultanées au pool

# Lu par docker-compose.yml UNIQUEMENT, pour créer le rôle et la base du
# service « postgres » et composer DATABASE_URL du service « mems » — inutile
# hors Docker, où DATABASE_URL ci-dessus suffit à lui seul.
POSTGRES_PASSWORD=

# Sauvegardes (pg_dump/pg_restore) : dossier où elles sont écrites, et délai
# maximal accordé à une sauvegarde ou à une restauration.
BACKUP_DIR=./data/sauvegardes
BACKUP_TIMEOUT_S=600

# Secrets — OBLIGATOIRES en production, 32 caractères minimum.
# Générez-les avec :  openssl rand -hex 32
JWT_SECRET=
DATA_KEY=

# Durée de validité d'une session
TOKEN_TTL=8h

# Origines autorisées à appeler l'API, séparées par des virgules.
# En production, mettez l'adresse réelle du site, jamais « * ».
CORS_ORIGINS=https://mems.votre-domaine.org

# Mettre à 1 si l'application est derrière un reverse proxy (nginx, Traefik…)
TRUST_PROXY=0

# Garde-fous
RATE_LOGIN_MAX=10          # tentatives de connexion par quart d'heure
RATE_API_MAX=600           # requêtes API par minute
MAX_BODY_MB=25             # taille maximale d'un corps JSON
# Téléversement du découpage administratif (route /geo/shapefile UNIQUEMENT, jamais
# le corps JSON global). Un .shp de fokontany pèse des dizaines de mégaoctets.
MAX_SHAPEFILE_MB=150       # taille maximale d'un shapefile déposé
#
# ⚠ Si vous publiez MEMS derrière un reverse proxy, RELEVEZ AUSSI SA LIMITE : elle
#   s'applique AVANT que la requête n'atteigne MEMS, et un dépassement rend une
#   erreur 413 que l'application ne voit jamais passer.
#     nginx    : client_max_body_size 200m;   ← la valeur par défaut est 1 Mo
#     Traefik  : aucune limite par défaut
#     Caddy    : aucune limite par défaut
#     Cloudflare : 100 Mo sur les offres gratuites, non modifiable
#   À défaut, déposez une archive .zip : elle compresse fortement le .shp.
BCRYPT_ROUNDS=12           # coût du hachage des mots de passe
LOCK_AFTER_FAILED=8        # échecs avant verrouillage du compte
LOCK_MINUTES=15            # durée du verrouillage

# Sources externes que le serveur a le droit d'aller lire, séparées par des
# virgules. Laissées vides — le cas normal — seuls les hôtes https dont l'adresse
# est publique sont joignables : c'est ce qui empêche qu'une adresse saisie dans
# l'interface fasse interroger le réseau interne ou le service de métadonnées de
# l'hébergeur. Ne renseignez ces listes que pour un serveur interne légitime
# (ODK Central sur site, passerelle d'entreprise), en le nommant explicitement.
ODK_ALLOWED_HOSTS=
# Connecteurs sortants : Palantir Foundry, API HTTP (Paramètres → Connecteurs)
CONNECTOR_ALLOWED_HOSTS=

# Justificatifs que MEMS obtient lui-même auprès d'une source — la SESSION d'ODK
# Central, la clé d'API de KoboToolbox. Aucune de ces valeurs n'est une durée de
# vie : celle-ci est annoncée par la source et fait foi. Elles règlent seulement
# ce que MEMS fait autour.
AUTH_SESSION_MARGIN_S=120       # renouveler ce délai avant l'échéance annoncée
AUTH_SESSION_MIN_INTERVAL_S=30  # jamais deux ouvertures plus rapprochées que cela
AUTH_SESSION_DEFAULT_TTL_S=3600 # échéance retenue quand la source n'en annonce aucune
AUTH_SESSION_RETRY_DELAY_S=300  # blocage après un refus de la source, levé en corrigeant la fiche
AUTH_SESSION_TIMEOUT_S=20       # délai d'un appel d'ouverture, corps de la réponse compris

# Compte administrateur créé par « npm run seed ».
# Laissez BOOTSTRAP_PASSWORD vide : un mot de passe sera tiré au hasard
# et affiché une seule fois dans la console.
BOOTSTRAP_EMAIL=admin@votre-domaine.org
BOOTSTRAP_PASSWORD=

# Jeu de démonstration (bureaux fictifs, 300+ sites d'exemple, contrats TPM
# factices). NE PAS activer en production : « npm run seed » y crée alors une
# base NUE, avec pour seul contenu le compte administrateur ci-dessus.
# Mettez SEED_DEMO=1 uniquement sur un poste de découverte/développement.
# (Les tests l'activent d'eux-mêmes via NODE_ENV=test.)
SEED_DEMO=

LOG_LEVEL=info             # error | warn | info | debug

# ─────────────────────────────────────────────────────────────────────
#  Exécution des scripts d'analyse R et SPSS sur le serveur
#
#  ⚠  AVERTISSEMENT — LISEZ CECI AVANT DE RENSEIGNER QUOI QUE CE SOIT.
#  Renseigner l'une de ces deux variables autorise l'exécution de CODE
#  ARBITRAIRE sur le serveur, avec les droits du compte système qui fait
#  tourner MEMS. Un script R ou SPSS n'est pas une formule de tableur : il
#  peut lire tous les fichiers que ce compte peut lire (la base SQLite, ce
#  fichier .env, les sauvegardes), écrire où ce compte peut écrire, et
#  appeler le réseau. MEMS écarte les variables d'environnement de
#  l'application, borne la durée, l'espace de travail et les sorties, et
#  journalise chaque exécution — mais il ne peut PAS transformer le serveur
#  en bac à sable. N'activez la fonction que si MEMS tourne dans un
#  conteneur dédié dont la perte est acceptable, sous un compte système
#  sans privilèges, avec des limites de processeur et de mémoire posées par
#  l'hôte. Laissées vides — le cas par défaut — les routes d'exécution
#  répondent 503 et aucun script n'est lancé.
#
#  La fonction est en outre réservée au SUPER-UTILISATEUR : ni un
#  administrateur, ni un valideur ne peuvent lancer un script.
#
#  Chemins ABSOLUS des interpréteurs (`which Rscript`, `which pspp`).
#  pspp est l'implémentation libre du langage SPSS ; il n'en existe pas
#  d'autre. Laissez vide l'interpréteur que vous ne voulez pas ouvrir.
ANALYSIS_R=
ANALYSIS_SPSS=

# Garde-fous de l'exécution. Les valeurs par défaut conviennent à un usage
# normal ; ne les desserrez qu'en connaissance de cause.
ANALYSIS_TIMEOUT_S=60      # au-delà, le GROUPE de processus du script est tué
ANALYSIS_KILL_GRACE_S=3    # délai entre le SIGTERM et le SIGKILL
ANALYSIS_MAX_OUTPUT_KB=256 # stdout et stderr ; au-delà la sortie est annoncée tronquée
ANALYSIS_MAX_ROWS=200000   # lignes du jeu de données transmis au script
ANALYSIS_MAX_DATASET_MB=32 # poids du CSV écrit dans le répertoire de travail
ANALYSIS_MAX_FILES=25      # fichiers produits récupérés (graphiques, CSV de sortie)
ANALYSIS_MAX_FILE_MB=16    # poids d'un fichier produit
ANALYSIS_KEEP_RUNS=20      # exécutions dont les fichiers restent téléchargeables
ANALYSIS_RESULT_TTL_MIN=60 # durée pendant laquelle ils le restent
ANALYSIS_MAX_CONCURRENT=2  # exécutions simultanées

# Répertoire des espaces de travail temporaires. Par défaut celui du système.
# Donnez-en un distinct à chaque instance MEMS d'une même machine : au
# démarrage, chacune efface les résultats qu'elle y trouve.
ANALYSIS_WORKDIR=

# Environnement transmis au script. C'est TOUT ce qu'il reçoit : ni
# JWT_SECRET, ni DATA_KEY, ni DATABASE_URL, ni aucune autre variable de MEMS.
# N'y mettez jamais de secret — ce que vous écrivez ici, le script le lit.
ANALYSIS_PATH=/usr/local/bin:/usr/bin:/bin
ANALYSIS_LANG=C.UTF-8
