# ─────────────────────────────────────────────────────────────────────
#  MEMS — variables d'environnement
#  Copiez ce fichier en « .env » et renseignez-le. Ne le versionnez jamais.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Emplacement de la base SQLite. En conteneur, montez ce dossier en volume.
DB_FILE=./data/mems.db

# Secrets — OBLIGATOIRES en production, 32 caractères minimum.
# Générez-les avec :  openssl rand -hex 32
JWT_SECRET=
DATA_KEY=

# Durée de validité d'une session
TOKEN_TTL=8h

# Origines autorisées à appeler l'API, séparées par des virgules.
# En production, mettez l'adresse réelle du site, jamais « * ».
CORS_ORIGINS=https://mems.votre-domaine.org

# Mettre à 1 si l'application est derrière un reverse proxy (nginx, Traefik…)
TRUST_PROXY=0

# Garde-fous
RATE_LOGIN_MAX=10          # tentatives de connexion par quart d'heure
RATE_API_MAX=600           # requêtes API par minute
MAX_BODY_MB=25             # taille maximale d'une requête
BCRYPT_ROUNDS=12           # coût du hachage des mots de passe
LOCK_AFTER_FAILED=8        # échecs avant verrouillage du compte
LOCK_MINUTES=15            # durée du verrouillage

# Compte administrateur créé par « npm run seed ».
# Laissez BOOTSTRAP_PASSWORD vide : un mot de passe sera tiré au hasard
# et affiché une seule fois dans la console.
BOOTSTRAP_EMAIL=admin@votre-domaine.org
BOOTSTRAP_PASSWORD=

LOG_LEVEL=info             # error | warn | info | debug

# ── Mise à jour depuis le dépôt ───────────────────────────────────────
# Se choisit à l'installation (« npm run setup »), jamais depuis l'application :
# un bouton qui va chercher du code sur internet et redémarre le service est un
# chemin d'exécution de code à distance. Rien de ce qui suit ne peut être modifié
# par une requête HTTP.
#
#   off       (défaut) la fonction n'existe pas ; les routes répondent 501
#   git       avance rapide sur UPDATE_BRANCH, puis migration et reconstruction
#   commande  exécute UPDATE_COMMAND telle quelle (conteneurs)
UPDATE_MODE=off
# UPDATE_REMOTE=origin
# UPDATE_BRANCH=main
# UPDATE_COMMAND=docker compose pull && docker compose up -d
# UPDATE_BACKUP=1        # sauvegarde JSON avant ; son échec annule la mise à jour
# UPDATE_MIGRATE=1
# UPDATE_BUILD=1
# UPDATE_RESTART=0       # à n'activer que si un superviseur relance le service
# UPDATE_TIMEOUT=600
